{
  "llm": {
    "provider": "openai",
    "model": "deepseek-ai/DeepSeek-V3.2",
    "api_base": "https://api.siliconflow.cn",
    "api_key_env": "LLM_API_KEY",
    "temperature": 0.7,
    "max_tokens": 12000,
    "timeout_seconds": 600,
    "use_mock": false
  },
  "pipeline": {
    "total_chapters": 3800,
    "mini_test_chapters": 10,
    "medium_test_chapters": 70,
    "sliding_window_size": 50,
    "recent_memory_window": 30,
    "max_review_retries": 2,
    "scene_per_chapter": {
      "min": 3,
      "max": 4
    },
    "merge_synopsis_into_directing": true,
    "allow_whole_chapter_rewrite": false
  },
  "quality": {
    "pass_threshold": 88,
    "fix_threshold": 60,
    "publication_line": 88,
    "min_chapter_score": 60,
    "min_pacing": 7.5,
    "min_innovation": 7.0,
    "target_avg_score": 88,
    "overuse_window_chapters": 100,
    "overuse_count_threshold": 4,
    "well_received_min_confidence": 0.6
  },
  "provider": {
    "family": "siliconflow",
    "api_base": "https://api.siliconflow.cn",
    "model": "deepseek-ai/DeepSeek-V3.2",
    "reasoning_fallback": false,
    "thinking_param": null,
    "cache_bust_suffix": "\n\n[请直接给出最终答案，严格使用合法 JSON，不要使用思考模式，不要输出任何分析或推理过程。]",
    "retry_temperatures": [
      0.7,
      0.6
    ]
  },
  "review_llm": {
    "api_base": "https://api.siliconflow.cn",
    "model": "deepseek-ai/DeepSeek-V3.2",
    "api_key_env": "LLM_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "timeout_seconds": 60,
    "use_mock": false
  },
  "review_provider": {
    "family": "siliconflow",
    "reasoning_fallback": false,
    "thinking_param": null,
    "retry_temperatures": [
      0.3,
      0.4,
      0.2,
      0.5
    ]
  },
  "fallback_llm": {
    "api_base": "https://apihub.agnes-ai.com",
    "model": "agnes-2.5-flash",
    "api_key_env": "AGNES_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "timeout_seconds": 600,
    "use_mock": false
  },
  "autonomy": {
    "audit_interval_chapters": 50,
    "chapter_regen_max_retries": 2,
    "remediation_rounds": 1,
    "remediation_max_retries": 2,
    "failover_trigger_consecutive_errors": 3,
    "max_backoff_seconds": 1800,
    "resume_state_file": "runtime/last_success_chapter.txt"
  },
  "forbidden": {
    "rules_file": "config/forbidden.json"
  },
  "commit": {
    "hash_algorithm": "sha256",
    "verify_on_read": true
  },
  "recovery": {
    "default_policy": "pause_and_log"
  },
  "model_router": {
    "phases": {
      "scenes": [
        "deepseek-ai/DeepSeek-V3.2"
      ],
      "polish": [
        "deepseek-ai/DeepSeek-V3.2"
      ],
      "planning": [
        "deepseek-ai/DeepSeek-V3.2"
      ],
      "synopsis": [
        "deepseek-ai/DeepSeek-V3.2"
      ],
      "review": [
        "deepseek-ai/DeepSeek-V3.2"
      ],
      "director": [
        "deepseek-ai/DeepSeek-V3.2"
      ]
    },
    "limits": {
      "deepseek-ai/DeepSeek-V3.2": {
        "rpm": 1000,
        "tpm": 100000
      },
      "deepseek-ai/DeepSeek-V3.1-Terminus": {
        "rpm": 1000,
        "tpm": 100000
      },
      "deepseek-ai/DeepSeek-V3": {
        "rpm": 1000,
        "tpm": 100000
      },
      "Qwen/Qwen3.5-9B": {
        "rpm": 1000,
        "tpm": 50000
      },
      "Qwen/Qwen3.5-27B": {
        "rpm": 1000,
        "tpm": 100000
      },
      "inclusionAI/Ling-mini-2.0": {
        "rpm": 1000,
        "tpm": 50000
      },
      "agnes-2.5-flash": {
        "rpm": 20,
        "tpm": 200000
      }
    },
    "probe_on_startup": false,
    "max_parallel_chapters": 1
  },
  "quality_policy": {
    "chapter_target_chars": 8000,
    "scene_target_chars": 2150,
    "min_ratio": 0.85,
    "max_ratio": 1.3125,
    "tolerance_chars": 100,
    "publication_line": 88,
    "severity_map": {
      "leak_scaffolding": "hard",
      "truncation": "hard",
      "verbatim_duplication": "hard",
      "forbidden_block": "hard",
      "scene_missing": "hard",
      "length_deviation": "note",
      "beat_repetition_thematic": "note",
      "hook_missing": "note"
    }
  }
}