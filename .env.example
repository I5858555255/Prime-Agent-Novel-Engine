# Novel Engine API Keys 变量清单
# 本文件仅是变量名清单模板，不存放密钥。
# 实际密钥文件: src/novel_engine/.env (入口 B run_volume 优先读; 双变量: active 名 + 任一 legacy 名)
#              或 src/.env (入口 A launch_prod.bat fallback / 入口 B 兜底)
# 两个文件均不入库 (.gitignore 覆盖)。

# profile siliconflow (siliconflow → LLM_API_KEY)
LLM_API_KEY=your_siliconflow_api_key_here

# profile agnes / agnes_30 (→ AGNES_API_KEY)
AGNES_API_KEY=your_agnes_api_key_here

# profile agnes_30_token (当前 active, 见 llm_providers.json 的 active_profile; → AGNES_TOKEN_API_KEY)
AGNES_TOKEN_API_KEY=your_agnes_token_api_key_here

# 兼容残留: run_volume._check_keys 启动门与 llm_client.from_config 默认参数读取; active 主链路不用
ZLEAP_MODEL_API_KEY=your_zleap_api_key_here

# 切换 active profile: python -m novel_engine.config.switch_llm <profile>
# (全路径 packages/coding-agent/skills/novel-engine/src/novel_engine/config/switch_llm.py,
#  勿与 scripts/control/select_llm.py 混淆)
